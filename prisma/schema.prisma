generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

generator prismaIDB {
  provider = "idb-client-generator"
  output   = "./generated/prisma-idb"

  // Optional: Enable sync engine
  // outboxSync = true
  // rootModel  = "User"
  // exclude    = ["Changelog", "Session"]
}

datasource db {
  provider = "postgresql"
}

enum GameId {
  none
  clairobscur
  remnant2
  slaythespire2
}

enum BuildVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum BuildModeratorStatus {
  PENDING
  APPROVED
  REJECTED
  LOCKED
}

model User {
  id            String         @id @default(cuid())
  username      String         @unique
  email         String         @unique
  emailVerified Boolean        @default(false)
  name          String?
  image         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      Session[]
  accounts      Account[]
  verification  Verification[]

  UserProfile       UserProfile?
  UserFavoriteGames UserFavoriteGame[]

  UsersBeingFollowed UserFollowedUsers[] @relation("userBeingFollowed")
  UsersFollowed      UserFollowedUsers[] @relation("userFollowed")

  UserRoles UserRole[] @relation("UserRoles")

  ClairObscurCollectedItems ClairObscurCollectedItem[]

  Remnant2CollectedItems   Remnant2CollectedItem[]
  Remnant2Builds           Remnant2Build[]
  Remnant2BuildCollections Remnant2BuildCollection[]
  Remnant2BuildUpvotes     Remnant2BuildUpvote[]

  SlayTheSpire2CollectedItems SlayTheSpire2CollectedItem[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  User                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userId     String?
  User       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([identifier, value])
  @@index([userId])
}

model UserProfile {
  id                  String               @id @default(cuid())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  displayName         String?
  bio                 String?              @db.Text
  avatarUrl           String?
  primaryAvatarId     String?
  primaryAvatarGameId GameId?
  UserAvatarOverrides UserAvatarOverride[]
  User                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String               @unique
}

model UserAvatarOverride {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  // The game whose profile this override applies to.
  gameId        GameId
  avatarId      String
  // The game the avatar art itself comes from - may differ from gameId, e.g. a
  // Clair Obscur avatar used on the Remnant 2 profile.
  avatarGameId  GameId
  UserProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  userProfileId String

  @@unique([userProfileId, gameId])
}

model UserFavoriteGame {
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  gameId    GameId

  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@id([userId, gameId])
  @@index([gameId])
}

model UserFollowedUsers {
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  User           User     @relation("userBeingFollowed", fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  FollowedUser   User     @relation("userFollowed", fields: [followedUserId], references: [id], onDelete: Cascade)
  followedUserId String

  @@id([userId, followedUserId])
  @@index([followedUserId])
}

enum Role {
  USER
  MODERATOR
  ADMIN
  SUPERADMIN
}

model UserRole {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  User   User   @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)

  role Role

  @@unique([userId, role])
  // Reverse lookup only; [userId] is already the unique-index prefix.
  @@index([role])
}

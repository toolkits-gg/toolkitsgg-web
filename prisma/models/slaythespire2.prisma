enum SlayTheSpire2ItemCategory {
  RELIC
  CARD
  POTION
  CHARACTER
  ANCIENT
}

enum SlayTheSpire2UncollectableItemCategory {
  ANCIENT
}

enum SlayTheSpire2PotionRarity {
  COMMON
  UNCOMMON
  RARE
  EVENT
  TOKEN
}

enum SlayTheSpire2RelicRarity {
  STARTER
  COMMON
  UNCOMMON
  RARE
  ANCIENT
  SHOP
  EVENT
  SPECIAL
}

enum SlayTheSpire2Character {
  IRONCLAD
  SILENT
  REGENT
  DEFECT
  NECROBINDER
}

enum SlayTheSpire2Ancient {
  NEOW
  OROBAS
  PAEL
  TEZCATARA
  DARV
  NONUPEIPE
  TANX
  VAKUU
}

enum SlayTheSpire2DLC {
  BASE
}

model SlayTheSpire2Item {
  id       String  @id
  name     String
  disabled Boolean @default(false)

  // SlayTheSpire2 specific fields
  category       SlayTheSpire2ItemCategory
  CollectedItems SlayTheSpire2CollectedItem[]
}

model SlayTheSpire2CollectedItem {
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  Item   SlayTheSpire2Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId String

  // used for "collected items for user X".
  @@id([userId, itemId])
}

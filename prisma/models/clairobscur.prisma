enum ClairObscurItemCategory {
  CHARACTER
  LUMINA
  PICTO
  SKILL
  WEAPON
}

enum ClairObscurCharacter {
  GUSTAVE
  LUNE
  MAELLE
  SCIEL
  VERSO
  MONOCO
}

enum ClairObscurAttribute {
  VITALITY
  MIGHT
  AGILITY
  DEFENSE
  LUCK
}

enum ClairObscurElement {
  DARK
  EARTH
  FIRE
  ICE
  LIGHT
  LIGHTNING
  PHYSICAL
  VOID
}

enum ClairObscurStat {
  ATTACK_POWER
  SPEED
  CRITICAL_RATE
  HEALTH
  DEFENSE
}

enum ClairObscurDLC {
  BASE
}

model ClairObscurItem {
  id       String  @id
  name     String
  disabled Boolean @default(false)

  // ClairObscur specific fields
  category       ClairObscurItemCategory
  CollectedItems ClairObscurCollectedItem[]
}

model ClairObscurCollectedItem {
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  Item   ClairObscurItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId String

  // used for "collected items for user X".
  @@id([userId, itemId])
}

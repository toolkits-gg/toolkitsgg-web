{
  "name": "toolkitsgg-web-tanstack",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "@/prisma": "./prisma/client"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "type": "tsc --noEmit",
    "post-cta-init": "npx -y create-db@latest --user-agent tanstack/tsrouter",
    "prisma-idb-tsc-fix": "node -e \"const fs=require('fs'),f='prisma/generated/prisma-idb/client/prisma-idb-client.ts',c=fs.readFileSync(f,'utf8');if(!c.startsWith('// @ts-nocheck'))fs.writeFileSync(f,'// @ts-nocheck\\n'+c)\"",
    "db:generate": "dotenv -e .env.local -- prisma generate && pnpm prisma-idb-tsc-fix",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:seed": "dotenv -e .env.local -- tsx prisma/seed.ts",
    "db:local:start": "docker compose -f compose.local.yaml up -d",
    "db:local:stop": "docker compose -f compose.local.yaml stop",
    "db:local:restart": "docker compose -f compose.local.yaml restart",
    "db:local:down": "docker compose -f compose.local.yaml down -v",
    "favicons:generate": "gulp generateFavicons",
    "images:generate": "gulp generateItemImages"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.6.11",
    "@faker-js/faker": "10.3.0",
    "@fontsource/geist": "5.2.8",
    "@mantine/carousel": "9.2.1",
    "@mantine/code-highlight": "9.2.1",
    "@mantine/core": "9.2.1",
    "@mantine/dates": "9.2.1",
    "@mantine/hooks": "9.2.1",
    "@mantine/modals": "9.2.1",
    "@mantine/notifications": "9.2.1",
    "@mantine/spotlight": "9.2.1",
    "@mantine/tiptap": "9.2.1",
    "@paralleldrive/cuid2": "3.3.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@react-email/ui": "6.1.5",
    "@tanstack/match-sorter-utils": "8.19.4",
    "@tanstack/react-form": "1.32.0",
    "@tanstack/react-query": "5.100.11",
    "@tanstack/react-router": "1.170.4",
    "@tanstack/react-router-ssr-query": "1.167.0",
    "@tanstack/react-start": "1.168.6",
    "@tanstack/react-store": "0.11.0",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.13.24",
    "@tanstack/router-plugin": "1.168.6",
    "@tanstack/store": "0.11.0",
    "@tiptap/extension-link": "3.22.3",
    "@tiptap/pm": "3.22.3",
    "@tiptap/react": "3.22.3",
    "@tiptap/starter-kit": "3.22.3",
    "better-auth": "1.6.11",
    "clsx": "2.1.1",
    "culori": "4.0.2",
    "dayjs": "1.11.20",
    "dotenv": "17.4.2",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "idb": "8.0.3",
    "modern-screenshot": "4.7.0",
    "next-themes": "0.4.6",
    "nuqs": "2.8.9",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "prisma": "7.8.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-icons": "5.6.0",
    "react-markdown": "10.1.0",
    "recharts": "3.8.1",
    "resend": "6.12.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@prisma-idb/idb-client-generator": "0.37.0",
    "@tanstack/devtools-event-client": "0.4.3",
    "@tanstack/devtools-vite": "0.7.0",
    "@tanstack/react-devtools": "0.10.5",
    "@tanstack/react-query-devtools": "5.100.11",
    "@tanstack/react-router-devtools": "1.167.0",
    "@testing-library/dom": "10.4.1",

NODE_ENV=development

# ========================================
# Public variables
# ========================================
VITE_APP_NAME="Toolkits.gg"
VITE_APP_DESCRIPTION="An open-source and ad-free platform providing item collection management, build planning and sharing, and more for a variety of games."
VITE_APP_URL="http://localhost:3000"
VITE_APP_NOREPLY_EMAIL="noreply@app.toolkits.gg"
VITE_CLOUDFRONT_URL="https://d1ig3kkc8hj9hz.cloudfront.net"
VITE_ENABLE_MAINTENANCE_MODE="false"
VITE_SHOW_COMING_SOON="true"

# ========================================
# Super admin account
# ========================================
# Required in every environment. `pnpm db:seed` guarantees this
# account exists and holds a global SUPERADMIN role. An existing account's
# password is never rewritten, so changing this value here does not rotate it.
SUPER_ADMIN_EMAIL="admin@abcdefghijkl.com"
SUPER_ADMIN_PASSWORD="adminpw!"

# ========================================
# Local seed accounts (local development only)
# ========================================
# Read only by `prisma/seed-reset.ts`. Do NOT set these in production or preview.
# The moderator pair is optional; omit it and the fixture is skipped.
LOCAL_USER_EMAIL="user@abcdefhijkl.com"
LOCAL_USER_PASSWORD="userpw!"
LOCAL_MODERATOR_EMAIL="moderator@abcdefhijkl.com"
LOCAL_MODERATOR_PASSWORD="modpw!"

# ========================================
# Database Configuration
# ========================================
# PostgreSQL connection string for local development with Docker
# If using the local Docker PostgreSQL setup (pnpm db:local:start), use:
DATABASE_URL="postgresql://toolkitsgg:toolkitsgg_dev_password@localhost:5432/toolkitsgg_db"
DATABASE_URL_UNPOOLED=
# For production or other database providers, replace with your connection string

# ========================================
# Authentication Configuration
# ========================================
# IMPORTANT: Generate a secure random secret for production
# You can generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Should match VITE_APP_URL
BETTER_AUTH_URL="http://localhost:3000"

# ========================================
# Third-Party API Keys
# ========================================
# Discord OAuth
DISCORD_CLIENT_ID="
DISCORD_CLIENT_SECRET=""
# Reddit OAuth
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
# Resend
RESEND_KEY=""
# Sentry
SENTRY_AUTH_TOKEN=""